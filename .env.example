# ==========================================
# WebRev — Environment Variables
# ==========================================

# Google PageSpeed Insights API Key
# Dapatkan API Key gratis di Google Cloud Console:
# https://developers.google.com/speed/docs/insights/v5/get-started
# Buat file bernama `.env.local` di folder root dan salin baris di bawah:
PAGESPEED_API_KEY=your_google_pagespeed_api_key_here

# Supabase (Database & Realtime untuk Fitur Live Stream Room Antrean)
# Dapatkan gratis di Dashboard Supabase (Project Settings -> API):
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Production Site URL
NEXT_PUBLIC_SITE_URL=https://webrev.primadev.id
